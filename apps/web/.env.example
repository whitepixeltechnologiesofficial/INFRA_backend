# @wpt/web runtime env vars (replacement web stack)
#
# Server (node server/wpt-server.mjs):
PORT=3000
# The scan QR and Web-session URL are built from the reachable base URL.
# Leave empty to auto-detect the first private LAN IPv4 at boot; set
# explicitly when running behind a tunnel/reverse proxy.
PUBLIC_BASE_URL=
WPT_PUBLIC_BASE_URL=
# QR linking-window TTL in ms before the token is refused (default 60000).
QR_TTL_MS=60000

# Next.js client — base URL of the WPT web server above (default: same origin).
NEXT_PUBLIC_WPT_API_URL=