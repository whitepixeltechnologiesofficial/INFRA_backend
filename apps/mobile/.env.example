EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Use the in-memory mock API (no backend / no network). Set to 'false' to hit the real backend.
# NOTE: push registration only fetches a real OS token (APNs/FCM) when this is 'false'.
# In mock mode the app registers a stable mock Expo token so the flow runs with no credentials.
EXPO_PUBLIC_USE_MOCK=true

# Dev convenience only (P3-2). When set to '1', the OTP screen auto-fills and
# auto-verifies the fixed MOCK OTP. Leave unset/off for manual entry so wrong-code
# and 30s-lockout behavior can be tested. Never affects the real backend path.
EXPO_PUBLIC_AUTO_VERIFY_OTP=

# ── ONB-1.7 two-physical-device testing ──
#
# To run the ONB-1.7 new-device handoff test with two Android/iOS devices:
#
# 1. Start the backend (needs PostgreSQL + the env vars from apps/backend/.env):
#    cd apps/backend && pnpm dev
#
# 2. On BOTH physical devices, set .env to:
#      EXPO_PUBLIC_USE_MOCK=false
#      EXPO_PUBLIC_API_BASE_URL=http://<YOUR_DESKTOP_LAN_IP>:4000
#    Replace <YOUR_DESKTOP_LAN_IP> with the IP your phone can reach on the LAN
#    (e.g. run `ipconfig` on Windows or `ifconfig` on macOS; use the Wi-Fi adapter IP).
#    Do NOT commit this address to version control.
#
# 3. Run Expo from the same computer:
#    cd apps/mobile && pnpm start
#
# 4. Both devices must connect via the same LAN to the Expo dev server and the
#    backend at the LAN IP above.
#
# Device A:
#   - Open the app, accept legal terms, enter phone number, receive + verify OTP.
#   - Stay in the app (foreground).
#
# Device B:
#   - Use the SAME phone number as Device A.
#   - Enter the same phone number, verify the OTP.
#
# Expected behavior:
#   Device B: login succeeds, "Logged In!" confirmation is displayed.
#   Device A: NO warning, NO popup, NO toast; session is silently invalidated.
#             If Device A was backgrounded/offline, bring it to the foreground —
#             it will detect the revoked session and silently return to phone-entry.
#
# NOTE: The EXPO_PUBLIC_BACKEND_URL var is used by the socket.io force_logout
# listener. It should match EXPO_PUBLIC_API_BASE_URL for two-device testing.
EXPO_PUBLIC_BACKEND_URL=
