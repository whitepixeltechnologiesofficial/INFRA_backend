{
  "expo": {
    "name": "WPT Mobile",
    "slug": "wpt-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wptmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.wptmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WPT to use your camera to scan QR codes and take photos in chats."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow WPT to find friends already on the app. Numbers are hashed on your phone and never uploaded."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3FC6B8",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow WPT to use your microphone to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WPT to attach photos you already have.",
          "cameraPermission": "Allow WPT to use your camera to take photos in chats."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
