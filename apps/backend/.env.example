PORT=4000
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000

# SMS delivery (optional). If unset, the OTP is NOT sent as a real SMS.
# To print the OTP to the server console for local development you must set
# BOTH NODE_ENV != production AND SMS_DEV_LOG=1. It is off by default and the
# raw OTP / phone number are never logged otherwise.
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
SMS_DEV_LOG=

# Real push delivery (optional). Leave 0/unset to keep the runnable mock
# provider (records deliveries in-memory, no credentials needed). Set to '1'
# only once APNs/FCM credentials are provisioned on exp.host and the app is out
# of mock mode (EXPO_PUBLIC_USE_MOCK=false on the client).
EXPO_PUSH_ENABLED=
