    {
      "name": "7. Moderation",
      "item": [
        {
          "name": "POST /moderation/warn",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reportId\": \"{{report_id}}\",\n    \"adminId\": \"{{admin_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/moderation/warn", "host": ["{{base_url}}"], "path": ["moderation", "warn"] },
            "description": "Admin only. Requires an admin token (see Collection-level 'Reset admin token' helper below or /debug/admin-token with debug enabled).\nBody must include reportId (uuid) and adminId (existing uuid in dashboard_admins).\nReturns {\"success\":true,\"action\":\"warn\",\"reportId\"}. 401 INVALID_ADMIN_TOKEN. 404 ADMIN_NOT_FOUND/REPORT_NOT_FOUND."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mint an admin JWT (HS256 signed with JWT_SECRET) in the sandbox.",
                  "const secret = pm.collectionVariables.get('jwt_secret');",
                  "if (secret) {",
                  "  const encoder = new TextEncoder();",
                  "  const b64url = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                  "  const header = { alg: 'HS256', typ: 'JWT' };",
                  "  const now = Math.floor(Date.now()/1000);",
                  "  const payload = { adm: 'admin', iat: now, exp: now + 60*60, iss: 'wpt-backend', sub: pm.collectionVariables.get('admin_id') };",
                  "  const signingInput = [b64url(encoder.encode(JSON.stringify(header))), b64url(encoder.encode(JSON.stringify(payload)))].join('.');",
                  "  const sig = CryptoJS.HmacSHA256(signingInput, secret).toString(CryptoJS.enc.Hex);",
                  "  const sigB64 = Buffer.from ? null : null;",
                  "  // base64url of the raw 32-byte signature bytes",
                  "  const bytes = [];",
                  "  for (let i = 0; i < 32; i++) bytes.push(parseInt(sig.substr(i*2, 2), 16));",
                  "  const sigUrl = btoa(String.fromCharCode(...bytes)).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                  "  const token = signingInput + '.' + sigUrl;",
                  "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /moderation/restrict",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reportId\": \"{{report_id}}\",\n    \"adminId\": \"{{admin_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/moderation/restrict", "host": ["{{base_url}}"], "path": ["moderation", "restrict"] },
            "description": "Admin only. Same body shape as /moderation/warn, action \"restrict\". Pre-request script mints the admin token."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.collectionVariables.get('jwt_secret');",
                  "if (secret) {",
                  "  const encoder = new TextEncoder();",
                  "  const b64url = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                  "  const header = { alg: 'HS256', typ: 'JWT' };",
                  "  const now = Math.floor(Date.now()/1000);",
                  "  const payload = { adm: 'admin', iat: now, exp: now + 60*60, iss: 'wpt-backend', sub: pm.collectionVariables.get('admin_id') };",
                  "  const signingInput = [b64url(encoder.encode(JSON.stringify(header))), b64url(encoder.encode(JSON.stringify(payload)))].join('.');",
                  "  const sig = CryptoJS.HmacSHA256(signingInput, secret).toString(CryptoJS.enc.Hex);",
                  "  const bytes = [];",
                  "  for (let i = 0; i < 32; i++) bytes.push(parseInt(sig.substr(i*2, 2), 16));",
                  "  const sigUrl = btoa(String.fromCharCode(...bytes)).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                  "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + signingInput + '.' + sigUrl });",
                  "}"
                ]
              }
            }
          ]
        },
