PORT=4000
DATABASE_URL=
JWT_SECRET=
# Dashboard-admin tokens are signed with a SEPARATE key (TAD 7.4). Both must be
# set; admin token issuance fails closed if this is missing.
DASHBOARD_JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
# Remote databases MUST declare sslmode (require or verify-full). Set this to a
# PEM file to enable certificate verification; without it the connection is
# encrypted but the server certificate is not authenticated.
DATABASE_CA_CERT=

# HMAC key for OTP code storage. OTP codes are hashed with HMAC-SHA256 rather
# than bare SHA-256, because a 6-digit code has only 1,000,000 possible values
# and an unsalted digest is brute-forceable offline in microseconds.
# Required - OTP verification fails closed without it.
OTP_HMAC_SECRET=

# Shared secret for GET /debug/admin-token. That endpoint mints a full
# dashboard-admin JWT with no password check, so it is protected by two
# independent gates: NODE_ENV must be development/test, and this secret must be
# presented. Set it even in local dev - without it the endpoint 404s.
# Leave blank in any deployed environment.
DEBUG_ADMIN_TOKEN_SECRET=

# Contact hash global salt (required for DB-2.3 privacy-preserving contact matching)
# Generate with: openssl rand -hex 32
# Supports both GLOBAL_SALT (per spec) and CONTACT_HASH_SALT (implementation name)
GLOBAL_SALT=
# CONTACT_HASH_SALT=  # Alternative name, GLOBAL_SALT takes precedence

# SMS delivery (optional). If unset, the OTP is printed to the server console
# as a dev fallback instead of being sent as a real SMS.
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
